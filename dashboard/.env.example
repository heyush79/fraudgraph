# All optional. Vite reads these at build time (and `vite` dev reads them at start).

# Where the data comes from (docs/showcase-contract.md section 1):
#   live   (default) case service over HTTP + WebSocket, analyst agent over HTTP
#   replay static files under <base>/showcase/, no backend; `npm run build:replay`
# VITE_DATA_MODE=live

# "true" hides every control that mutates state (the case status control). Set it
# for any public deployment, live or replay; build:replay always sets it.
# VITE_READ_ONLY=true

# The path the app is served under. "/" for nginx and dev; the GitHub Pages build
# is served from /fraudgraph/, so: VITE_BASE=/fraudgraph/ npm run build:replay
# (read by vite.config.ts from the environment, not from this file).
# VITE_BASE=/

# Empty / unset => same-origin. The dev server proxies /cases, /stats, /internal
# and /ws to http://localhost:8082 and /agent to http://localhost:8010 (see
# vite.config.ts), and the nginx image proxies them to the compose services, so
# these are only needed to point a build at services somewhere else.
# VITE_API_BASE=http://localhost:8082
# VITE_AGENT_BASE=http://localhost:8010

# Development only: answer chat questions from a fixture built out of the real
# case instead of calling the agent (same as adding ?fixture to the URL). Never
# active in a production build.
# VITE_ASK_FIXTURE=true
