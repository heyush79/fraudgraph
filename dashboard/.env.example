# Empty / unset => same-origin. The dev server proxies /cases, /stats, /internal
# and /ws to http://localhost:8082 (see vite.config.ts), and the nginx image
# proxies them to http://case-service:8082, so this is only needed when you want
# the dashboard to talk to a case-service somewhere else.
# VITE_API_BASE=http://localhost:8082
