# Settings for a public deployment. Copy to deploy/public.env (gitignored) and fill in.

# The hostname Caddy gets a certificate for. With no domain of your own, use sslip.io:
# a VM at 203.0.113.10 is reachable as 203-0-113-10.sslip.io.
FRAUDGRAPH_DOMAIN=

# The analyst agent's model key (console.groq.com, free tier). Without it the console still
# works; "Ask the analyst" reports that the analyst is offline.
GROQ_API_KEY=

# "Ask the analyst" limits. Groq's free tier allows gpt-oss-120b 8,000 tokens a minute and
# 200,000 a day, and one answer costs roughly 3,000 to 4,000 tokens (about 7,000 when the
# model asks for extra evidence first). Identical questions are answered from a cache and
# cost nothing, so the suggested questions stay cheap however often they are clicked.
FRAUDGRAPH_ASK_RATE_GLOBAL_MIN=2      # 2 x ~4k tokens keeps the deployment under 8k a minute
FRAUDGRAPH_ASK_RATE_GLOBAL_DAY=40     # ~160k tokens, leaving headroom under the daily 200k
FRAUDGRAPH_ASK_RATE_IP_MIN=2          # one visitor cannot take the whole minute
FRAUDGRAPH_ASK_RATE_IP_DAY=12         # nor a whole day's budget

# Traffic. 20 tps is plenty to watch and keeps disk and CPU modest on a free VM.
GEN_TPS=20
# Two days of decisions and labels: enough to retrain on (make train TRAIN_HOURS=24), small
# enough for the disk. Only applies to topics created after it is set, i.e. a fresh VM.
FRAUDGRAPH_TOPIC_RETENTION_MS=172800000
