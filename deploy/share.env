# Analyst limits while `make share` exposes the laptop's stack. Sized as in
# public.env.example: Groq's free tier allows 8,000 tokens a minute and 200,000 a day, and one
# answer costs roughly 3,000 to 4,000.
FRAUDGRAPH_ASK_RATE_GLOBAL_MIN=2
FRAUDGRAPH_ASK_RATE_GLOBAL_DAY=40
FRAUDGRAPH_ASK_RATE_IP_MIN=2
FRAUDGRAPH_ASK_RATE_IP_DAY=12
